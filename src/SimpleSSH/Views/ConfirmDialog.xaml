<Window x:Class="SimpleSSH.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="13" Background="White">
    <StackPanel Margin="20,16,20,16">
        <TextBlock x:Name="Heading" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap"/>
        <TextBlock x:Name="Detail" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{StaticResource MutedTextBrush}"/>
        <CheckBox x:Name="DontAskBox" Margin="0,14,0,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="OkButton" IsDefault="True" Style="{StaticResource DialogButton}" Click="Ok_Click"/>
            <Button Content="Cancel" IsCancel="True" Style="{StaticResource DialogButton}"/>
        </StackPanel>
    </StackPanel>
</Window>
