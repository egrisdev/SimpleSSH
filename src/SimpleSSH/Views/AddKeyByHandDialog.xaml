<Window x:Class="SimpleSSH.Views.AddKeyByHandDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add a key by hand" Width="580" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="13" Background="White">
    <Window.Resources>
        <Style x:Key="StepIcon" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Width" Value="22"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Foreground" Value="#9CA3AF"/>
        </Style>
        <Style x:Key="StepTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="StepDetail" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="20,16,20,16">
        <TextBlock x:Name="Heading" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap"/>
        <TextBlock x:Name="SubHeading" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,0" FontFamily="Cascadia Mono, Consolas" FontSize="12"/>
        <TextBlock TextWrapping="Wrap" Margin="0,10,0,0">
            For a server that already refuses passwords. SimpleSSH made a new key for it; add the key from a session
            that already gets in, such as your other SSH program or the server's console.
        </TextBlock>

        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,14,0,0">
            <StackPanel>
                <DockPanel>
                    <TextBlock x:Name="Icon1" Text="1" Style="{StaticResource StepIcon}" DockPanel.Dock="Left" Foreground="#0F6CBD"/>
                    <StackPanel>
                        <TextBlock x:Name="Step1Title" Style="{StaticResource StepTitle}"/>
                        <TextBox x:Name="CommandBox" Margin="0,6,0,0" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="140"
                                 VerticalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas" FontSize="11.5" Padding="6,4"
                                 Background="#F8FAFC" AutomationProperties.Name="Command to run on the server"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button x:Name="CopyCommandButton" Content="Copy command" Padding="12,3" Click="CopyCommand_Click"/>
                            <TextBlock Margin="14,0,0,0" VerticalAlignment="Center" FontSize="12">
                                <Hyperlink Click="CopyPublicKey_Click">Copy just the public key</Hyperlink>
                            </TextBlock>
                        </StackPanel>
                        <TextBlock x:Name="CopiedText" Margin="0,6,0,0" FontSize="12" Foreground="#166534" TextWrapping="Wrap" Visibility="Collapsed"/>
                        <TextBlock x:Name="Detail1" Style="{StaticResource StepDetail}" Margin="0,6,0,0"
                                   Text="It adds the key to ~/.ssh/authorized_keys (once, however often you run it) and sets the permissions SSH needs. Nothing else changes."/>
                    </StackPanel>
                </DockPanel>
                <DockPanel Margin="0,12,0,0">
                    <TextBlock x:Name="Icon2" Text="2" Style="{StaticResource StepIcon}" DockPanel.Dock="Left"/>
                    <StackPanel>
                        <TextBlock Text="Test it" Style="{StaticResource StepTitle}"/>
                        <TextBlock x:Name="Detail2" Style="{StaticResource StepDetail}"
                                   Text="SimpleSSH logs in with the key alone. If that works, the key is kept for this connection."/>
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </Border>

        <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="{StaticResource ErrorBrush}" Visibility="Collapsed"/>
        <TextBlock x:Name="BusyText" Margin="0,12,0,0" Foreground="{StaticResource MutedTextBrush}" Visibility="Collapsed"/>

        <DockPanel Margin="0,16,0,0" LastChildFill="False">
            <TextBlock x:Name="SkipTestLink" DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="12" Visibility="Collapsed">
                <Hyperlink Click="SaveWithoutTest_Click">Keep the key without testing</Hyperlink>
            </TextBlock>
            <Button DockPanel.Dock="Right" x:Name="CloseButton" Content="Cancel" IsCancel="True" Style="{StaticResource DialogButton}"/>
            <Button DockPanel.Dock="Right" x:Name="TestButton" Content="Test and save" IsDefault="True" Style="{StaticResource DialogButton}"
                    MinWidth="110" Click="Test_Click"/>
        </DockPanel>
    </StackPanel>
</Window>
