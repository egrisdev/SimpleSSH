<Window x:Class="SimpleSSH.Views.PasswordPromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="400" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="13" Background="White">
    <StackPanel Margin="20,16,20,16">
        <TextBlock x:Name="Prompt" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <PasswordBox x:Name="Box" Style="{StaticResource FieldBox}" AutomationProperties.Name="Password"/>
            <TextBox x:Name="BoxText" Style="{StaticResource FieldBox}" Visibility="Collapsed" AutomationProperties.Name="Password (shown)"/>
            <CheckBox Grid.Column="1" x:Name="ShowBox" Content="Show" Margin="10,0,0,0" VerticalAlignment="Center"
                      Checked="Show_Changed" Unchecked="Show_Changed"/>
        </Grid>
        <TextBlock x:Name="Note" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="11.5" Foreground="{StaticResource MutedTextBrush}"
                   Text="Used once for this change and not saved."/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="OK" IsDefault="True" Style="{StaticResource DialogButton}" Click="Ok_Click"/>
            <Button Content="Cancel" IsCancel="True" Style="{StaticResource DialogButton}"/>
        </StackPanel>
    </StackPanel>
</Window>
