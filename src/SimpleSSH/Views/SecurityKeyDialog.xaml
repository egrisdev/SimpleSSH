<Window x:Class="SimpleSSH.Views.SecurityKeyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Security key" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="13" Background="White" PreviewKeyDown="Window_PreviewKeyDown">
    <StackPanel Margin="20,16,20,16">

        <!-- ===== Off ===== -->
        <StackPanel x:Name="OffPanel">
            <TextBlock Text="Protect saved passwords with a security key" FontWeight="SemiBold" FontSize="14"/>
            <TextBlock TextWrapping="Wrap" Margin="0,8,0,0">
                Saved passwords are encrypted with your Windows account. Turn this on and they also need your
                FIDO2 security key (YubiKey, Feitian, Google Titan and others): touch it and enter its PIN once
                when SimpleSSH starts.
            </TextBlock>
            <TextBlock TextWrapping="Wrap" Margin="0,8,0,0">
                You also get a recovery key to keep in your password manager, in case the security key is lost.
            </TextBlock>
            <TextBlock TextWrapping="Wrap" Margin="0,8,0,0" FontSize="11.5" Foreground="{StaticResource MutedTextBrush}">
                The key needs a PIN (Windows helps you set one) and the hmac-secret feature, which most FIDO2 keys have.
                Setting up takes two touches.
            </TextBlock>
            <Button x:Name="TurnOnButton" Content="Turn on…" HorizontalAlignment="Left" MinWidth="110" Height="30" Margin="0,14,0,0" Click="TurnOn_Click"/>
        </StackPanel>

        <!-- ===== On ===== -->
        <StackPanel x:Name="OnPanel" Visibility="Collapsed">
            <DockPanel>
                <Border x:Name="StateBadge" DockPanel.Dock="Right" CornerRadius="9" Padding="9,1" VerticalAlignment="Center" Background="#DCFCE7">
                    <TextBlock x:Name="StateText" FontSize="11.5" Text="Unlocked" Foreground="#166534"/>
                </Border>
                <TextBlock Text="Saved passwords are protected with a security key" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap"/>
            </DockPanel>

            <TextBlock Text="Security keys" FontWeight="SemiBold" Margin="0,16,0,4"/>
            <ListBox x:Name="KeyList" Height="86" SelectionChanged="KeyList_SelectionChanged" AutomationProperties.Name="Security keys"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button x:Name="AddKeyButton" Content="Add another key…" Padding="10,0" Height="28" Click="AddKey_Click"
                        ToolTip="A second key works as a spare. Each key unlocks on its own."/>
                <Button x:Name="RemoveKeyButton" Content="Remove" Padding="10,0" Height="28" Margin="8,0,0,0" IsEnabled="False" Click="RemoveKey_Click"/>
            </StackPanel>

            <TextBlock Text="Lock saved passwords" FontWeight="SemiBold" Margin="0,16,0,4"/>
            <RadioButton x:Name="LockOnCloseRadio" GroupName="LockWhen" Content="When SimpleSSH closes" Margin="0,2,0,0" Checked="LockWhen_Changed"/>
            <RadioButton x:Name="LockOnWindowsLockRadio" GroupName="LockWhen" Content="When SimpleSSH closes or Windows locks" Margin="0,4,0,0" Checked="LockWhen_Changed"/>
            <TextBlock TextWrapping="Wrap" Margin="20,2,0,0" FontSize="11.5" Foreground="{StaticResource MutedTextBrush}"
                       Text="Open sessions stay connected. You touch the key again the next time a saved password is needed."/>

            <TextBlock Text="Recovery key" FontWeight="SemiBold" Margin="0,16,0,4"/>
            <DockPanel>
                <Button x:Name="NewRecoveryButton" DockPanel.Dock="Right" Content="New recovery key…" Padding="10,0" Height="28" Margin="12,0,0,0" Click="NewRecovery_Click"
                        VerticalAlignment="Top"/>
                <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="{StaticResource MutedTextBrush}"
                           Text="Unlocks your passwords without a security key, on any PC. Make a new one if the old one may have been seen; the old one then stops working."/>
            </DockPanel>

            <Separator Margin="0,16,0,10"/>
            <DockPanel>
                <Button x:Name="TurnOffButton" DockPanel.Dock="Left" Content="Turn off…" Padding="10,0" Height="28" Click="TurnOff_Click"
                        ToolTip="Go back to encrypting saved passwords with your Windows account only"/>
                <TextBlock/>
            </DockPanel>
        </StackPanel>

        <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed"/>
        <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{StaticResource ErrorBrush}" Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="CloseButton" Content="Close" IsDefault="True" Style="{StaticResource DialogButton}" Click="CloseButton_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
