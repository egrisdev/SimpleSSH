<Window x:Class="SimpleSSH.Views.AuthPromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Verification" Width="380" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Topmost="False"
        FontFamily="Segoe UI" FontSize="13" Background="White">
    <StackPanel Margin="20,16,20,16">
        <TextBlock x:Name="Header" TextWrapping="Wrap" FontWeight="SemiBold"/>
        <TextBlock x:Name="Instruction" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" Visibility="Collapsed"/>
        <StackPanel x:Name="Fields" Margin="0,12,0,14"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" IsDefault="True" Style="{StaticResource DialogButton}" Click="Ok_Click"/>
            <Button Content="Cancel" IsCancel="True" Style="{StaticResource DialogButton}"/>
        </StackPanel>
    </StackPanel>
</Window>
