<Window x:Class="SimpleSSH.Views.RecoveryKeyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Save your recovery key" Width="500" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="13" Background="White">
    <StackPanel Margin="20,16,20,16">
        <TextBlock Text="Save your recovery key" FontWeight="SemiBold" FontSize="14"/>
        <TextBlock TextWrapping="Wrap" Margin="0,6,0,0">
            If your security key is lost or broken, this recovery key is the only way to unlock your saved passwords.
            Store it in your password manager. It is shown only now.
        </TextBlock>

        <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="KeyBox" IsReadOnly="True" Height="34" VerticalContentAlignment="Center" Padding="4,0" HorizontalContentAlignment="Center"
                     FontFamily="Cascadia Mono, Consolas" FontSize="14" Background="#F8FAFC"
                     AutomationProperties.Name="Recovery key"/>
            <Button Grid.Column="1" x:Name="CopyButton" Content="Copy" MinWidth="84" Height="34" Margin="8,0,0,0" Click="Copy_Click"
                    ToolTip="Copy to the clipboard (kept out of clipboard history, cleared after 2 minutes)"/>
        </Grid>
        <TextBlock x:Name="CopiedText" Margin="0,4,0,0" FontSize="11.5" Foreground="{StaticResource MutedTextBrush}" Text=" "/>

        <TextBlock x:Name="ReplaceNote" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="11.5" Foreground="{StaticResource MutedTextBrush}" Visibility="Collapsed"
                   Text="Your previous recovery key stops working when you choose Done."/>

        <CheckBox x:Name="SavedBox" Margin="0,12,0,0" Content="I saved my recovery key in a safe place" Checked="Saved_Changed" Unchecked="Saved_Changed"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="DoneButton" Content="Done" IsDefault="True" IsEnabled="False" Style="{StaticResource DialogButton}" Click="Done_Click"/>
            <Button Content="Cancel" IsCancel="True" Style="{StaticResource DialogButton}"/>
        </StackPanel>
    </StackPanel>
</Window>
