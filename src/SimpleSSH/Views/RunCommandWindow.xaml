<Window x:Class="SimpleSSH.Views.RunCommandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Run command" Width="820" Height="600" MinWidth="480" MinHeight="320"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="True"
        Icon="pack://application:,,,/Assets/SimpleSSH.ico"
        FontFamily="Segoe UI" FontSize="13" Background="White" Closing="Window_Closing">
    <DockPanel Margin="16,14,16,12">
        <!-- Command line -->
        <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="TargetsText" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,8" MaxHeight="40" TextTrimming="CharacterEllipsis"/>
            <DockPanel>
                <Button x:Name="RunButton" DockPanel.Dock="Right" Content="Run" IsDefault="True" Padding="18,0" Margin="8,0,0,0" Click="Run_Click"/>
                <TextBox x:Name="CommandBox" Height="30" VerticalContentAlignment="Center" Padding="6,0"
                         FontFamily="Cascadia Mono, Consolas" FontSize="13.5" AutomationProperties.Name="Command"
                         BorderBrush="{StaticResource BorderBrush}" TextChanged="CommandBox_TextChanged"/>
            </DockPanel>
        </StackPanel>

        <!-- Footer -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Button x:Name="CopyButton" DockPanel.Dock="Right" Content="Copy all output" Padding="12,4" Click="Copy_Click" IsEnabled="False"/>
            <TextBlock x:Name="SummaryText" VerticalAlignment="Center" Foreground="#374151"/>
        </DockPanel>

        <!-- One card per connection -->
        <ScrollViewer Margin="0,12,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="Results">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Margin="0,0,0,8" Background="White">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="10,6">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" Foreground="{Binding StatusBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    <Ellipse Width="8" Height="8" Fill="{Binding StatusBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Endpoint}" Foreground="{StaticResource MutedTextBrush}" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12"/>
                                </DockPanel>
                                <TextBox Text="{Binding Output, Mode=OneWay}" IsReadOnly="True" BorderThickness="0,1,0,0" BorderBrush="{StaticResource BorderBrush}"
                                         Background="#FAFAFB" FontFamily="Cascadia Mono, Consolas" FontSize="12.5" Padding="8,6"
                                         TextWrapping="NoWrap" MaxHeight="280" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                         Visibility="{Binding OutputVisibility}"/>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
