<UserControl x:Class="SimpleSSH.Controls.FilesView"
             MouseUp="View_MouseUp"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White" FontFamily="Segoe UI" FontSize="13">
    <UserControl.Resources>
        <Geometry x:Key="FolderIcon">M0.5,2 H4.5 L5.5,3 H11.5 V10 H0.5 Z</Geometry>
        <Geometry x:Key="FileIcon">M1.5,0.5 H6.5 L9.5,3.5 V11.5 H1.5 Z M6.5,0.5 V3.5 H9.5</Geometry>
        <Geometry x:Key="ParentIcon">M6,11 V1.5 M2,5.5 L6,1.5 L10,5.5</Geometry>
        <Style x:Key="Icon" TargetType="Path">
            <Setter Property="StrokeThickness" Value="1"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="Width" Value="13"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="Margin" Value="0,0,7,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <!-- Toolbar: up, path, actions -->
        <Border x:Name="Toolbar" DockPanel.Dock="Top" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,6">
            <DockPanel>
                <StackPanel x:Name="Actions" DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
                    <Button x:Name="UploadButton" Style="{StaticResource ToolButton}" Content="Upload…" Click="Upload_Click" ToolTip="Upload files (or drag files here)"/>
                    <Button x:Name="DownloadButton" Style="{StaticResource ToolButton}" Content="Download…" Click="Download_Click" ToolTip="Download the selected items"/>
                    <Button x:Name="NewFolderButton" Style="{StaticResource ToolButton}" Content="New folder" Click="NewFolder_Click"/>
                    <Button x:Name="DeleteButton" Style="{StaticResource ToolButton}" Content="Delete" Click="Delete_Click" ToolTip="Delete the selected items (Del)"/>
                    <Button x:Name="RefreshButton" Style="{StaticResource ToolButton}" Content="Refresh" Click="Refresh_Click" ToolTip="Refresh (F5)"/>
                </StackPanel>
                <Button x:Name="UpButton" DockPanel.Dock="Left" Style="{StaticResource ToolButton}" Content="↑" FontSize="14" Padding="9,2"
                        Click="Up_Click" ToolTip="Parent folder (Backspace)" AutomationProperties.Name="Parent folder"/>
                <TextBox x:Name="PathBox" Height="28" VerticalContentAlignment="Center" Padding="6,0" Margin="4,0,0,0"
                         FontFamily="Cascadia Mono, Consolas" KeyDown="PathBox_KeyDown" AutomationProperties.Name="Remote path"
                         BorderBrush="{StaticResource BorderBrush}"/>
            </DockPanel>
        </Border>

        <!-- Status + progress -->
        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Background="{StaticResource SidebarBrush}" Padding="10,4">
            <DockPanel>
                <Button x:Name="CancelButton" DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Content="Cancel" Visibility="Collapsed" Click="Cancel_Click" Margin="8,0,0,0"/>
                <ProgressBar x:Name="Progress" DockPanel.Dock="Right" Width="160" Height="8" Visibility="Collapsed" Margin="8,0,0,0"/>
                <TextBlock x:Name="StatusText" FontSize="11.5" Foreground="#374151" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <Grid>
            <ListView x:Name="List" BorderThickness="0" SelectionMode="Extended" AllowDrop="True"
                      MouseDoubleClick="List_MouseDoubleClick" KeyDown="List_KeyDown" Drop="List_Drop" DragOver="List_DragOver"
                      AutomationProperties.Name="Remote files">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Name" Width="320">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Path x:Name="Glyph" Style="{StaticResource Icon}" Data="{StaticResource FileIcon}" Stroke="#6B7280" Fill="White"/>
                                        <TextBlock Text="{Binding Name}"/>
                                        <TextBlock x:Name="ParentHint" Text="Parent folder" Margin="10,0,0,0" Foreground="{StaticResource MutedTextBrush}" Visibility="Collapsed"/>
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                            <Setter TargetName="Glyph" Property="Data" Value="{StaticResource FolderIcon}"/>
                                            <Setter TargetName="Glyph" Property="Stroke" Value="#B7791F"/>
                                            <Setter TargetName="Glyph" Property="Fill" Value="#FCE7B2"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsParent}" Value="True">
                                            <Setter TargetName="Glyph" Property="Data" Value="{StaticResource ParentIcon}"/>
                                            <Setter TargetName="Glyph" Property="Stroke" Value="{StaticResource AccentBrush}"/>
                                            <Setter TargetName="Glyph" Property="Fill" Value="Transparent"/>
                                            <Setter TargetName="Glyph" Property="StrokeThickness" Value="1.4"/>
                                            <Setter TargetName="ParentHint" Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Size" Width="90">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding SizeText}" TextAlignment="Right" MinWidth="70"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Modified" Width="140" DisplayMemberBinding="{Binding ModifiedText}"/>
                        <GridViewColumn Header="Permissions" Width="100">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Entry.Permissions}" FontFamily="Cascadia Mono, Consolas" Foreground="{StaticResource MutedTextBrush}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
                <ListView.ContextMenu>
                    <ContextMenu Opened="ListMenu_Opened">
                        <MenuItem x:Name="CtxOpen" Header="_Open" FontWeight="SemiBold" Click="Open_Click"/>
                        <MenuItem x:Name="CtxDownload" Header="_Download…" Click="Download_Click"/>
                        <Separator/>
                        <MenuItem x:Name="CtxRename" Header="_Rename…" InputGestureText="F2" Click="Rename_Click"/>
                        <MenuItem x:Name="CtxDelete" Header="De_lete" InputGestureText="Del" Click="Delete_Click"/>
                        <Separator/>
                        <MenuItem Header="_Upload…" Click="Upload_Click"/>
                        <MenuItem Header="_New folder" Click="NewFolder_Click"/>
                        <MenuItem Header="Re_fresh" InputGestureText="F5" Click="Refresh_Click"/>
                    </ContextMenu>
                </ListView.ContextMenu>
            </ListView>

            <!-- Connecting / error / empty messages -->
            <StackPanel x:Name="Overlay" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460" Visibility="Collapsed">
                <TextBlock x:Name="OverlayTitle" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="#1F2937" TextWrapping="Wrap" TextAlignment="Center"/>
                <TextBlock x:Name="OverlayText" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0"/>
                <Button x:Name="RetryButton" Content="Try again" HorizontalAlignment="Center" Padding="16,5" Margin="0,14,0,0" Click="Retry_Click" Visibility="Collapsed"/>
            </StackPanel>

            <!-- SCP fallback for devices without SFTP -->
            <Border x:Name="ScpPanel" Visibility="Collapsed" Background="White" AllowDrop="True" Drop="ScpPanel_Drop" DragOver="List_DragOver">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="460">
                    <TextBlock Text="Copy files with SCP" FontSize="15" FontWeight="SemiBold" Foreground="#1F2937"/>
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,14"
                               Text="This device doesn't offer SFTP, so its files can't be listed. You can still send and fetch files: enter a path on the device, or drop files here to send them."/>
                    <TextBlock Text="Path on the device" Margin="0,0,0,4"/>
                    <TextBox x:Name="ScpPathBox" Style="{StaticResource FieldBox}" FontFamily="Cascadia Mono, Consolas"
                             AutomationProperties.Name="Path on the device" ToolTip="For example flash:/backup.cfg, /tmp/ or a file name (relative to the login folder)"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button x:Name="ScpSendButton" Content="Send file…" Padding="14,5" Margin="0,0,8,0" Click="ScpSend_Click"/>
                        <Button x:Name="ScpFetchButton" Content="Fetch file…" Padding="14,5" Click="ScpFetch_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
