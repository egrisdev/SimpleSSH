<Window x:Class="SimpleSSH.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SimpleSSH.ViewModels"
        Title="SimpleSSH" Height="800" Width="1280" MinWidth="720" MinHeight="420"
        Icon="pack://application:,,,/Assets/SimpleSSH.ico"
        Background="White"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing">

    <Window.Resources>
        <Geometry x:Key="PlusIcon">M5,0 L5,10 M0,5 L10,5</Geometry>
        <Geometry x:Key="EditIcon">M1,9.5 L1.5,7 L7.5,1 L9.5,3 L3.5,9 Z M6.5,2 L8.5,4</Geometry>
        <Geometry x:Key="DeleteIcon">M0.5,2.5 H9.5 M3.5,2.5 V0.8 H6.5 V2.5 M1.8,2.5 L2.6,10 H7.4 L8.2,2.5 M4,4.5 V8.2 M6,4.5 V8.2</Geometry>
        <Geometry x:Key="TagIcon">M0.5,0.5 H5.5 L10.5,5.5 L5.5,10.5 L0.5,5.5 Z M3,3 m-0.9,0 a0.9,0.9 0 1,0 1.8,0 a0.9,0.9 0 1,0 -1.8,0</Geometry>
        <Geometry x:Key="TerminalIcon">M0.5,0.5 H12.5 V9.5 H0.5 Z M2.5,3 L4.5,5 L2.5,7 M5.5,7 H8.5</Geometry>
        <Geometry x:Key="DesktopIcon">M0.5,0.5 H12.5 V8.5 H0.5 Z M4,11.5 H9 M6.5,8.5 V11.5</Geometry>
        <Geometry x:Key="ServerIcon">M0.5,0.5 H12.5 V5 H0.5 Z M0.5,6.5 H12.5 V11 H0.5 Z M2.5,2.75 H4 M2.5,8.75 H4 M9,2.75 H10.5 M9,8.75 H10.5</Geometry>
        <Geometry x:Key="GlobeIcon">M1,6 a5.5,5.5 0 1,0 11,0 a5.5,5.5 0 1,0 -11,0 Z M1,6 H12 M6.5,0.5 C4,3 4,9 6.5,11.5 M6.5,0.5 C9,3 9,9 6.5,11.5</Geometry>

        <Style x:Key="IconPath" TargetType="Path">
            <Setter Property="Stroke" Value="#374151"/>
            <Setter Property="StrokeThickness" Value="1.2"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <HierarchicalDataTemplate DataType="{x:Type vm:TagNode}" ItemsSource="{Binding Children}">
            <Border x:Name="DropBorder" BorderThickness="1" BorderBrush="Transparent" Background="Transparent" CornerRadius="4" Padding="3,0" Margin="-4,0,0,0">
                <StackPanel Orientation="Horizontal" Margin="0,3,0,3">
                    <Path Data="{StaticResource TagIcon}" Style="{StaticResource IconPath}" Stroke="#6B7280" Margin="0,0,7,0"/>
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Border Background="#E5E7EB" CornerRadius="8" Padding="6,0" Margin="7,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Count}" FontSize="11" Foreground="#4B5563"/>
                    </Border>
                </StackPanel>
            </Border>
            <HierarchicalDataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                    <Setter TargetName="DropBorder" Property="Background" Value="#DBEAFE"/>
                    <Setter TargetName="DropBorder" Property="BorderBrush" Value="#0F6CBD"/>
                </DataTrigger>
            </HierarchicalDataTemplate.Triggers>
        </HierarchicalDataTemplate>

        <DataTemplate DataType="{x:Type vm:ConnectionNode}">
            <StackPanel Orientation="Horizontal" Margin="0,2,0,2" ToolTip="{Binding ToolTip}" Background="Transparent">
                <Path x:Name="Glyph" Data="{StaticResource TerminalIcon}" Style="{StaticResource IconPath}" Stroke="#0F6CBD" Margin="0,0,7,0"/>
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedTextBrush}" FontSize="11.5" Margin="8,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsRdp}" Value="True">
                    <Setter TargetName="Glyph" Property="Data" Value="{StaticResource DesktopIcon}"/>
                    <Setter TargetName="Glyph" Property="Stroke" Value="#7C3AED"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsConsole}" Value="True">
                    <Setter TargetName="Glyph" Property="Data" Value="{StaticResource ServerIcon}"/>
                    <Setter TargetName="Glyph" Property="Stroke" Value="#047857"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsWeb}" Value="True">
                    <Setter TargetName="Glyph" Property="Data" Value="{StaticResource GlobeIcon}"/>
                    <Setter TargetName="Glyph" Property="Stroke" Value="#C2410C"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <Menu DockPanel.Dock="Top" Background="White" Padding="4,2">
            <MenuItem Header="_File" SubmenuOpened="FileMenu_Opened">
                <MenuItem Header="_New connection…" InputGestureText="Ctrl+Shift+N" Click="NewConnection_Click"/>
                <Separator/>
                <MenuItem Header="Security _key…" Click="SecurityKey_Click"/>
                <MenuItem x:Name="MenuLockPasswords" Header="_Lock saved passwords" Click="LockPasswords_Click"/>
                <Separator/>
                <MenuItem Header="Open _data folder" Click="OpenDataFolder_Click"/>
                <MenuItem Header="Open connections._json in Notepad" Click="OpenJson_Click"/>
                <MenuItem Header="_Reload connections from disk" Click="ReloadConnections_Click"/>
                <Separator/>
                <MenuItem Header="E_xit" InputGestureText="Alt+F4" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_Connection" SubmenuOpened="ConnectionMenu_Opened">
                <MenuItem x:Name="MenuConnect" Header="_Connect" InputGestureText="Enter" Click="Connect_Click"/>
                <MenuItem x:Name="MenuFiles" Header="Open _files" Click="OpenFiles_Click"/>
                <MenuItem x:Name="MenuRun" Header="_Run command…" Click="RunCommand_Click"/>
                <MenuItem x:Name="MenuRdpWindow" Header="Open in Remote _Desktop window" Click="OpenRdpWindow_Click"/>
                <MenuItem x:Name="MenuBrowser" Header="Open in _browser" Click="OpenInBrowser_Click"
                          ToolTip="Open the controller's web page in your web browser"/>
                <MenuItem x:Name="MenuKeyLogin" Header="Switch to _key login…" Click="KeyLogin_Click"
                          ToolTip="Make a key for this server, add it using your password, prove it works, then optionally turn off password logins"/>
                <MenuItem x:Name="MenuPasswordLogin" Header="Switch to _password login…" Click="PasswordLogin_Click"
                          ToolTip="Turn password logins back on, prove the password works, then stop using the key"/>
                <Separator/>
                <MenuItem x:Name="MenuEdit" Header="_Edit…" InputGestureText="F2" Click="Edit_Click"/>
                <MenuItem x:Name="MenuDuplicate" Header="D_uplicate" Click="Duplicate_Click"/>
                <MenuItem x:Name="MenuDelete" Header="_Delete" InputGestureText="Del" Click="Delete_Click"/>
            </MenuItem>
            <MenuItem Header="_Tab" SubmenuOpened="TabMenu_Opened">
                <MenuItem x:Name="MenuReconnect" Header="_Reconnect" InputGestureText="Ctrl+Shift+R" Click="ReconnectTab_Click"/>
                <MenuItem x:Name="MenuDuplicateTab" Header="_Duplicate tab" Click="DuplicateTab_Click"/>
                <MenuItem x:Name="MenuClearTab" Header="C_lear screen" Click="ClearTab_Click"/>
                <MenuItem x:Name="MenuFullScreen" Header="_Full screen" InputGestureText="Ctrl+Alt+Break" Click="FullScreen_Click"/>
                <Separator/>
                <MenuItem x:Name="MenuNextTab" Header="_Next tab" InputGestureText="Ctrl+Tab" Click="NextTab_Click"/>
                <MenuItem x:Name="MenuPrevTab" Header="_Previous tab" InputGestureText="Ctrl+Shift+Tab" Click="PrevTab_Click"/>
                <Separator/>
                <MenuItem x:Name="MenuCloseTab" Header="_Close tab" InputGestureText="Ctrl+Shift+W" Click="CloseTab_Click"/>
                <MenuItem x:Name="MenuCloseOthers" Header="Close _other tabs" Click="CloseOtherTabs_Click"/>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Expand all tags" Click="ExpandAll_Click"/>
                <MenuItem Header="_Collapse all tags" Click="CollapseAll_Click"/>
                <Separator/>
                <MenuItem Header="_Find connection" InputGestureText="Ctrl+Shift+F" Click="FocusSearch_Click"/>
                <Separator/>
                <MenuItem x:Name="MenuCloseTabOnExit" Header="Close tab when session _exits" IsCheckable="True" Click="CloseTabOnExit_Click"/>
                <MenuItem x:Name="MenuConfirmTagMoves" Header="Confirm before moving between _tags" IsCheckable="True" Click="ConfirmTagMoves_Click"
                          ToolTip="Drag a connection onto another tag to move it there (hold Ctrl to keep the old tag too)."/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_Keyboard shortcuts" Click="Shortcuts_Click"/>
                <MenuItem Header="_About SimpleSSH" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Background="{StaticResource SidebarBrush}">
            <DockPanel Margin="10,3">
                <TextBlock x:Name="DataPathText" DockPanel.Dock="Right" Foreground="{StaticResource MutedTextBrush}" FontSize="11.5"/>
                <TextBlock x:Name="LockStatus" DockPanel.Dock="Right" FontSize="11.5" Margin="0,0,16,0" Visibility="Collapsed">
                    <Hyperlink x:Name="LockLink" Click="LockLink_Click" TextDecorations="{x:Null}"><Run x:Name="LockLinkText"/></Hyperlink>
                </TextBlock>
                <TextBlock x:Name="StatusText" FontSize="11.5" Foreground="#374151" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="280" MinWidth="180"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <!-- ============ Sidebar ============ -->
            <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,8,8,4">
                        <Button Style="{StaticResource ToolButton}" Click="NewConnection_Click" ToolTip="New connection (Ctrl+Shift+N)" x:Name="AddButton">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource PlusIcon}" Style="{StaticResource IconPath}" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.6" Margin="0,0,6,0"/>
                                <TextBlock Text="Add"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="EditButton" Style="{StaticResource ToolButton}" Click="Edit_Click" ToolTip="Edit selected connection (F2)">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource EditIcon}" Style="{StaticResource IconPath}" Margin="0,0,6,0"/>
                                <TextBlock Text="Edit"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="DeleteButton" Style="{StaticResource ToolButton}" Click="Delete_Click" ToolTip="Remove selected connection (Del)">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource DeleteIcon}" Style="{StaticResource IconPath}" Stroke="#B91C1C" Margin="0,0,6,0"/>
                                <TextBlock Text="Remove"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <Grid DockPanel.Dock="Top" Margin="8,4,8,6">
                        <TextBox x:Name="SearchBox" Height="28" Padding="6,0,24,0" VerticalContentAlignment="Center"
                                 TextChanged="SearchBox_TextChanged" PreviewKeyDown="SearchBox_PreviewKeyDown"
                                 BorderBrush="{StaticResource BorderBrush}"/>
                        <TextBlock x:Name="SearchPlaceholder" Text="Filter connections…" IsHitTestVisible="False"
                                   Foreground="#9CA3AF" Margin="9,0,0,0" VerticalAlignment="Center"/>
                        <Button x:Name="ClearSearchButton" Content="✕" HorizontalAlignment="Right" Width="22" Height="22" Margin="0,0,3,0"
                                Style="{StaticResource ToolButton}" Padding="0" FontSize="10" Visibility="Collapsed" Click="ClearSearch_Click"/>
                    </Grid>

                    <Grid>
                        <TreeView x:Name="Tree" BorderThickness="0" Background="Transparent" Padding="2,0,0,8"
                                  MouseDoubleClick="Tree_MouseDoubleClick" KeyDown="Tree_KeyDown"
                                  PreviewMouseRightButtonDown="Tree_PreviewMouseRightButtonDown"
                                  SelectedItemChanged="Tree_SelectedItemChanged"
                                  AllowDrop="True"
                                  PreviewMouseLeftButtonDown="Tree_PreviewMouseLeftButtonDown" PreviewMouseMove="Tree_PreviewMouseMove"
                                  DragOver="Tree_DragOver" DragLeave="Tree_DragLeave" Drop="Tree_Drop"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                            <TreeView.Resources>
                                <!-- Keep the selection visible when the tree isn't focused (default inactive gray matches the sidebar). -->
                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#CFE3F7"/>
                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#111827"/>
                                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#E2E6EC"/>
                                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#111827"/>
                                <Style TargetType="TreeViewItem">
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                                    <Setter Property="Padding" Value="2,0"/>
                                </Style>
                            </TreeView.Resources>
                            <TreeView.ContextMenu>
                                <ContextMenu Opened="TreeContextMenu_Opened">
                                    <MenuItem x:Name="CtxConnect" Header="_Connect" FontWeight="SemiBold" Click="Connect_Click"/>
                                    <MenuItem x:Name="CtxFiles" Header="Open _files" Click="OpenFiles_Click"/>
                                    <MenuItem x:Name="CtxRun" Header="_Run command…" Click="RunCommand_Click"/>
                                    <MenuItem x:Name="CtxRdpWindow" Header="Open in Remote _Desktop window" Click="OpenRdpWindow_Click"/>
                                    <MenuItem x:Name="CtxBrowser" Header="Open in _browser" Click="OpenInBrowser_Click"/>
                                    <MenuItem x:Name="CtxKeyLogin" Header="Switch to _key login…" Click="KeyLogin_Click"/>
                                    <MenuItem x:Name="CtxPasswordLogin" Header="Switch to _password login…" Click="PasswordLogin_Click"/>
                                    <Separator/>
                                    <MenuItem x:Name="CtxEdit" Header="_Edit…" Click="Edit_Click"/>
                                    <MenuItem x:Name="CtxDuplicate" Header="D_uplicate" Click="Duplicate_Click"/>
                                    <MenuItem x:Name="CtxDelete" Header="_Delete" Click="Delete_Click"/>
                                    <Separator/>
                                    <MenuItem Header="_New connection…" Click="NewConnection_Click"/>
                                    <MenuItem x:Name="CtxOpenAll" Header="Open _all in this tag" Click="OpenAllInTag_Click"/>
                                    <MenuItem x:Name="CtxRunAll" Header="Run command on all in this tag…" Click="RunCommandOnTag_Click"/>
                                </ContextMenu>
                            </TreeView.ContextMenu>
                        </TreeView>

                        <StackPanel x:Name="EmptyTreeHint" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16" Visibility="Collapsed">
                            <TextBlock Text="No connections yet" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="#374151"/>
                            <TextBlock Text="Click Add to create one." Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{StaticResource BorderBrush}"
                          ResizeBehavior="PreviousAndNext" ShowsPreview="False" Focusable="False"/>

            <!-- ============ Tabs + terminals ============ -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#F9FAFB" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                    <!-- Only the header strip lives in the TabControl; terminals are hosted in TerminalHost below so their
                         WebView2 windows are never torn down when switching tabs. -->
                    <TabControl x:Name="Tabs" SelectionChanged="Tabs_SelectionChanged" Focusable="False"
                                ItemContainerStyle="{StaticResource TerminalTabItem}"
                                PreviewMouseLeftButtonDown="Tabs_PreviewMouseLeftButtonDown" PreviewMouseMove="Tabs_PreviewMouseMove"
                                PreviewMouseLeftButtonUp="Tabs_PreviewMouseLeftButtonUp" LostMouseCapture="Tabs_LostMouseCapture">
                        <TabControl.Template>
                            <ControlTemplate TargetType="TabControl">
                                <TabPanel IsItemsHost="True" Margin="6,6,6,-1" Background="Transparent"/>
                            </ControlTemplate>
                        </TabControl.Template>
                    </TabControl>
                </Border>

                <Grid x:Name="TerminalHost" Grid.Row="1" Background="{StaticResource TerminalBackgroundBrush}"/>

                <Border x:Name="EmptyState" Grid.Row="0" Grid.RowSpan="2" Background="White">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420">
                        <Path Data="{StaticResource TerminalIcon}" Style="{StaticResource IconPath}" Stroke="#9CA3AF" StrokeThickness="0.5"
                              Stretch="Uniform" Width="72" Height="56" HorizontalAlignment="Center" Margin="0,0,0,18"/>
                        <TextBlock Text="No open sessions" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="#1F2937"/>
                        <TextBlock Text="Double-click a connection in the list to open it in a new tab." TextWrapping="Wrap"
                                   TextAlignment="Center" Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,16"/>
                        <Button Content="Add a connection" HorizontalAlignment="Center" Padding="16,6" Click="NewConnection_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
