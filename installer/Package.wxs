<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <!-- UpgradeCode must never change: it is how newer MSIs find and replace older installs. -->
  <Package Name="SimpleSSH"
           Manufacturer="SimpleSSH contributors"
           Version="$(var.ProductVersion)"
           UpgradeCode="AE909D49-3FE2-43A4-90C8-5E89B08D15A9"
           Scope="perMachine"
           Compressed="yes">

    <SummaryInformation Description="SimpleSSH – tabbed SSH terminal" />

    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer version of [ProductName] is already installed."
                  Schedule="afterInstallInitialize" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- Add/Remove Programs -->
    <Icon Id="AppIcon" SourceFile="$(var.RepoRoot)\src\SimpleSSH\Assets\SimpleSSH.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPCOMMENTS" Value="Tabbed SSH terminal with a tagged connection list." />

    <!-- Layout -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="SimpleSSH" />
    </StandardDirectory>

    <Feature Id="Main" Title="SimpleSSH" Level="1" AllowAbsent="no">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="InstallFolderPermissions" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

    <!-- UI: welcome, license/notices, install folder, progress, finish (with "Launch SimpleSSH") -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.RepoRoot)\installer\License.rtf" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch SimpleSSH" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#SimpleSSHExe]" />
    <CustomAction Id="LaunchApplication" BinaryRef="Wix4UtilCA_X64" DllEntry="WixShellExec" Impersonate="yes" />
    <UI>
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchApplication"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed" />
    </UI>
  </Package>

  <Fragment>
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Component Id="MainExecutable">
        <File Id="SimpleSSHExe" Source="$(var.PublishDir)SimpleSSH.exe" KeyPath="yes" />
      </Component>
      <!-- Everything else from the self-contained publish folder (runtime, WPF, WebView2 loader, wwwroot\...) -->
      <Files Include="$(var.PublishDir)**">
        <Exclude Files="$(var.PublishDir)SimpleSSH.exe" />
        <Exclude Files="$(var.PublishDir)**\*.pdb" />
      </Files>
    </ComponentGroup>
  </Fragment>

  <Fragment>
    <!--
      The install folder gets the same locked-down permissions as Program Files whatever folder is chosen: a folder
      such as C:\SimpleSSH would otherwise let every user replace SimpleSSH's files (and run code as whoever starts
      it next).
      Owner Administrators; SYSTEM and Administrators full control; Users and app containers read and run only.
    -->
    <Component Id="InstallFolderPermissions" Directory="INSTALLFOLDER" Guid="2F7C9D3A-8E41-4B6C-9A5D-7E3B1C0F4A62">
      <CreateFolder>
        <PermissionEx Sddl="O:BAD:PAI(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)(A;OICI;0x1200a9;;;BU)(A;OICI;0x1200a9;;;AC)(A;OICI;0x1200a9;;;S-1-15-2-2)" />
      </CreateFolder>
    </Component>
  </Fragment>

  <Fragment>
    <!-- Standard WiX start-menu pattern: shortcut component keyed by an HKCU value (satisfies ICE38/43/57). -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="6B0C6E1E-4C6B-4F49-9E36-2E4E1C3B7A11">
        <Shortcut Id="SimpleSSHStartMenu"
                  Name="SimpleSSH"
                  Description="Tabbed SSH terminal"
                  Target="[INSTALLFOLDER]SimpleSSH.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon" />
        <RegistryValue Root="HKCU" Key="Software\SimpleSSH\Installer" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>
  </Fragment>
</Wix>
